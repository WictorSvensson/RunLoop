// Prisma schema for Runloop.
// Milestone 1 slice: User + DailyCheckin. More models (activities, symptoms,
// coach_*, etc.) will be added incrementally as features land.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  // Canonical lowercase username (e.g. "wictor"). Logins are matched
  // case-insensitively by lowercasing input before lookup.
  username     String   @unique
  // scrypt password hash ("saltHex:hashHex"). Never store plaintext.
  passwordHash String
  displayName  String?
  email        String?  @unique
  weightKg     Float?
  timezone     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyCheckins    DailyCheckin[]
  garminConnection GarminConnection?
  activities       Activity[]
  coachBriefs      CoachBrief[]
}

// One LLM-generated coaching brief per generation click. Every row stores the
// exact facts payload sent to the model, what it produced, and which model
// produced it — the audit trail doubles as the spend record. Newest row wins
// for display; history is kept, never overwritten.
model CoachBrief {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts          Json // bullet strings sent to the model
  interpretation String // produced section 02
  recommendation String // produced section 03
  model          String // deployment name used
  createdAt      DateTime @default(now())

  // Matches the newest-wins lookup: findFirst({ where: { userId }, orderBy: { createdAt: "desc" } }).
  @@index([userId, createdAt])
}

// Stores a user's Garmin Connect tokens (unofficial API). One connection per
// user. The Garmin password is NEVER stored — it is used once at connect
// time to obtain tokens, and only the exported token pair below persists.
// Tokens are re-exported and saved after every use since refresh rotates them.
model GarminConnection {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  garminUserId   String? // Garmin profile id (display/diagnostics only)
  username       String? // login email (hint for reconnect; not a secret)
  tokenJson      String // JSON.stringify of the library's exported token pair
  expiresAt      DateTime? // oauth2 expiry when known (null = unknown)
  lastSyncedAt   DateTime? // last successful activity import
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// A training activity imported from Garmin or Suunto. Only the objective
// fields the source provides are mapped here; subjective fields (RPE, shoes,
// symptoms) stay manual. `source` + `externalId` is the dedup key across
// providers: Garmin rows use the activity id, Suunto rows use
// the export filename stem (e.g. "2023-05-02_17.15.12-running").
model Activity {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source             String    @default("GARMIN") // "SUUNTO" | "GARMIN"
  externalId         String // provider-stable id for idempotent re-imports (required: NULLs bypass unique enforcement)
  name               String?
  type               String? // provider sport type, e.g. "Run", "TrailRun"
  startDate          DateTime // activity start (UTC)
  distance           Float? // meters
  movingTime         Int? // seconds
  elapsedTime        Int? // seconds
  averageSpeed       Float? // meters/second
  maxSpeed           Float? // meters/second
  averageHeartrate   Float? // bpm
  maxHeartrate       Float? // bpm
  totalElevationGain Float? // meters

  // Detailed fields, filled on-demand from GET /activities/{id} when a user
  // opens an activity. detailFetchedAt marks whether detail has been loaded.
  startDateLocal       DateTime? // activity start in the athlete's local time
  timezone             String?
  averageCadence       Float?
  averageWatts         Float?
  weightedAverageWatts Int?
  maxWatts             Int?
  kilojoules           Float?
  calories             Float?
  averageTemp          Int? // celsius
  description          String?
  gearId               String?
  gearName             String? // e.g. shoe name
  deviceName           String?
  detailFetchedAt      DateTime?
  analysisDataFetchedAt DateTime? // laps + streams captured for deterministic analysis

  laps                 ActivityLap[]
  stream               ActivityStream?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Same activity is never imported twice for a user, regardless of source.
  @@unique([userId, source, externalId])
  @@index([userId])
  @@index([userId, startDate])
}

model ActivityLap {
  id                 String   @id @default(cuid())
  activityId         String
  activity           Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lapIndex           Int
  name               String?
  startDate          DateTime?
  distance           Float?
  movingTime         Int?
  elapsedTime        Int?
  startIndex         Int?
  endIndex           Int?
  averageSpeed       Float?
  maxSpeed           Float?
  averageHeartrate   Float?
  maxHeartrate       Float?
  averageCadence     Float?
  averageWatts       Float?
  totalElevationGain Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([activityId, lapIndex])
  @@index([activityId])
}

// Raw provider streams are intentionally stored as one JSON document per activity
// for the first analysis prototype. This keeps ingestion lossless while the
// segment/classification model is still evolving. We can normalize later once
// query patterns are proven.
model ActivityStream {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  payload    Json
  fetchedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DailyCheckin {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime     @db.Date
  weight        Float?
  sleepDuration Int? // minutes
  sleepQuality  SleepQuality?
  energy        Int? // 1-5
  soreness      Severity?
  symptoms      Severity?
  notes         String?
  // Garmin health fields (also fillable by future sources; all optional and
  // manual-entry-safe like sleep — importers only fill empties via COALESCE).
  avgHrv        Int? // ms, 7-day or daily average depending on source
  restingHr     Int? // bpm
  bodyBattery   Int? // 0-100 Garmin Body Battery
  createdAt     DateTime @default(now())
  updatedAt     DateTime     @updatedAt

  // One check-in per user per day.
  @@unique([userId, date])
  @@index([userId])
}

enum SleepQuality {
  POOR
  OKAY
  GOOD
  EXCELLENT
}

enum Severity {
  NONE
  MILD
  MODERATE
  HIGH
}
